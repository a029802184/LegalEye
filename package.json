{
  "name": "legaleye",
  "private": true,
  "version": "2.0.0",
  "description": "法眼 LegalEye｜法務室智慧作業輔助系統（純前端、本機處理）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit --pretty",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/build-icons.mjs",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "postinstall": "node scripts/copy-ocr-assets.mjs"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "pdfjs-dist": "4.10.38",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@tesseract.js-data/chi_tra": "1.0.0",
    "@types/node": "20.17.10",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
